{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-led operation manual",
  "type": "object",
  "required": ["facts", "document", "pages"],
  "properties": {
    "facts": {"type": "object"},
    "document": {
      "type": "object",
      "required": ["title", "type", "edition"],
      "properties": {
        "title": {"type": "string"},
        "type": {"type": "string"},
        "edition": {"type": "string"},
        "status": {"type": "string"},
        "date": {"type": "string"}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "title"],
        "properties": {
          "kind": {"enum": ["cover", "toc", "content", "section"]},
          "title": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "eyebrow": {"type": "string"},
          "lead": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "blocks": {"type": "array"}
        }
      }
    }
  }
}
